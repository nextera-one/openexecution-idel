{
  "name": "openexecution-idel",
  "version": "1.1.0",
  "private": true,
  "description": "OpenExecution Runtime + IDEL Terminal: a policy-aware, audited, cross-platform execution runtime",
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rimraf packages/*/dist packages/registry/registries",
    "sync:xterm": "node scripts/sync-xterm-assets.mjs",
    "test": "vitest run && node --test desktop/shell.test.cjs",
    "test:watch": "vitest",
    "typecheck": "tsc --build --pretty false",
    "check:web": "node scripts/check-web.mjs",
    "check:package": "node scripts/check-package.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:bash": "bash scripts/smoke-test.sh",
    "upgrade:latest": "bash scripts/upgrade-latest.sh",
    "upgrade:latest:npm": "bash scripts/upgrade-latest.sh --npm",
    "publish:dry-run": "pnpm --config.node-linker=hoisted -r publish --dry-run --no-git-checks",
    "install:local": "bash scripts/install-local.sh",
    "serve": "node scripts/sync-xterm-assets.mjs && node packages/cli/bin/idel.js serve --static packages/web/public",
    "ui": "node scripts/sync-xterm-assets.mjs && node packages/cli/bin/idel.js serve --static packages/web/public --open",
    "ui:dev": "bash scripts/run-ui.sh",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:build:linux": "node scripts/build-desktop.mjs --platform linux",
    "desktop:build:macos": "node scripts/build-desktop.mjs --platform macos",
    "desktop:build:windows": "node scripts/build-desktop.mjs --platform windows",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:package": "pnpm desktop:prepare && electron-builder --config desktop/electron-builder.cjs --publish never",
    "desktop:package:linux": "pnpm desktop:package --linux --x64",
    "desktop:package:windows": "pnpm desktop:package --win --x64",
    "desktop:package:macos": "pnpm desktop:package --mac --arm64 --x64",
    "check:npm": "node scripts/check-npm-install.mjs",
    "check:pilot": "node scripts/check-pilot.mjs"
  },
  "engines": {
    "node": ">=22.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "electron": "^42.4.1",
    "electron-builder": "26.15.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "author": "Nextera One",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextera-one/openexecution-idel.git"
  },
  "homepage": "https://github.com/nextera-one/openexecution-idel#readme",
  "bugs": {
    "url": "https://github.com/nextera-one/openexecution-idel/issues"
  }
}
