{
  "name": "@openexecution/cli",
  "version": "1.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "idel": "./bin/idel.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "web"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "node scripts/copy-web.mjs"
  },
  "dependencies": {
    "@openexecution/types": "workspace:*",
    "@openexecution/runtime": "workspace:*",
    "@openexecution/registry": "workspace:*",
    "@openexecution/parser": "workspace:*",
    "@openexecution/openlogs": "workspace:*",
    "@openexecution/policy": "workspace:*",
    "@openexecution/server": "workspace:*",
    "@openexecution/agent": "workspace:*",
    "@openexecution/function": "workspace:*"
  },
  "description": "Command-line interface, REPL, and local server entrypoint for IDEL.",
  "license": "MIT",
  "author": "Nextera One",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextera-one/openexecution-idel.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/nextera-one/openexecution-idel#readme",
  "bugs": {
    "url": "https://github.com/nextera-one/openexecution-idel/issues"
  },
  "engines": {
    "node": ">=22.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
