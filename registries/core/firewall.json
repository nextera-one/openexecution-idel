        "android-root": { "status": "requires_capability", "adapter": "android-shell", "platform": "android", "requires": ["root", "iptables-or-nft"] }
      }
    },
    "examples": [
      "allow.network from=10.0.0.0/24 to=any port=443 protocol=tcp",
