[
  {
    "id": "search.apt.package",
    "version": "1.0.0",
    "summary": "Search APT package metadata on Debian/Ubuntu systems.",
    "category": "package",
    "riskDefault": "LOW",
    "params": {
      "query": { "type": "string", "required": true, "description": "Package search term." }
    },
    "adapters": {
      "posix": {
        "command": "apt",
        "args": [
          { "kind": "literal", "value": "search" },
          { "kind": "value", "param": "query" }
        ]
      }
    },
    "examples": ["search.apt.package query=git"],
    "tests": [{ "input": "search.apt.package query=git", "expectRisk": "LOW" }]
  },
  {
    "id": "show.apt.package",
    "version": "1.0.0",
    "summary": "Show details for an APT package.",
    "category": "package",
    "riskDefault": "LOW",
    "params": {
      "name": { "type": "string", "required": true, "description": "Package name." }
    },
    "adapters": {
      "posix": {
        "command": "apt",
        "args": [
          { "kind": "literal", "value": "show" },
          { "kind": "value", "param": "name" }
        ]
      }
    },
    "examples": ["show.apt.package name=git"],
    "tests": [{ "input": "show.apt.package name=git", "expectRisk": "LOW" }]
  },
  {
    "id": "update.apt.index",
    "version": "1.0.0",
    "summary": "Refresh APT package indexes with sudo apt update.",
    "category": "package",
    "riskDefault": "HIGH",
    "params": {},
    "adapters": {
      "posix": {
        "command": "sudo",
        "args": [
          { "kind": "literal", "value": "apt" },
          { "kind": "literal", "value": "update" }
        ],
        "semanticNotes": "Requires sudo on most systems. Interactive password prompts work best in a real terminal session."
      }
    },
    "examples": ["update.apt.index"],
    "tests": [{ "input": "update.apt.index", "expectRisk": "HIGH" }]
  },
  {
    "id": "install.apt.package",
    "version": "1.0.0",
    "summary": "Install an APT package with sudo apt install.",
    "category": "package",
    "riskDefault": "HIGH",
    "params": {
      "name": { "type": "string", "required": true, "description": "Package name to install." },
      "assumeYes": { "type": "boolean", "default": false, "description": "Pass -y to apt install." }
    },
    "adapters": {
      "posix": {
        "command": "sudo",
        "args": [
          { "kind": "literal", "value": "apt" },
          { "kind": "literal", "value": "install" },
          { "kind": "flag", "flag": "-y", "when": "assumeYes" },
          { "kind": "value", "param": "name" }
        ],
        "semanticNotes": "HIGH risk because it changes system packages. Default policy dry-runs it first."
      }
    },
    "examples": ["install.apt.package name=git", "install.apt.package name=git assumeYes=true"],
    "tests": [{ "input": "install.apt.package name=git", "expectRisk": "HIGH" }]
  },
  {
    "id": "remove.apt.package",
    "version": "1.0.0",
    "summary": "Remove an APT package with sudo apt remove.",
    "category": "package",
    "riskDefault": "HIGH",
    "params": {
      "name": { "type": "string", "required": true, "description": "Package name to remove." },
      "assumeYes": { "type": "boolean", "default": false, "description": "Pass -y to apt remove." }
    },
    "adapters": {
      "posix": {
        "command": "sudo",
        "args": [
          { "kind": "literal", "value": "apt" },
          { "kind": "literal", "value": "remove" },
          { "kind": "flag", "flag": "-y", "when": "assumeYes" },
          { "kind": "value", "param": "name" }
        ],
        "semanticNotes": "HIGH risk because removing packages can break dependent workflows."
      }
    },
    "examples": ["remove.apt.package name=git"],
    "tests": [{ "input": "remove.apt.package name=git", "expectRisk": "HIGH" }]
  },
