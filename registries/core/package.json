    "riskDefault": "HIGH",
    "params": {
      "id": { "type": "string", "required": true, "description": "Winget package id." },
      "exact": { "type": "boolean", "default": true, "description": "Pass -e for exact id matching." }
    },
    "adapters": {
      "powershell": {
        "command": "winget",
        "args": [
          { "kind": "literal", "value": "install" },
          { "kind": "literal", "value": "--id" },
          { "kind": "value", "param": "id" },
          { "kind": "flag", "flag": "-e", "when": "exact" }
        ],
        "semanticNotes": "HIGH risk because installers may change system state or trigger UAC prompts."
