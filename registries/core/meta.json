  },
  {
    "id": "registry.explain",
    "version": "1.0.0",
    "summary": "Explain how a command resolves: the winning layer plus any shadowed definitions.",
    "category": "meta",
    "riskDefault": "LOW",
    "params": {
      "command": { "type": "string", "required": true, "description": "Command id to explain, e.g. remove.folder." }
    },
    "adapters": {},
    "examples": ["registry.explain command=remove.folder"],
    "tests": [{ "input": "registry.explain command=remove.folder", "expectRisk": "LOW" }]
  },
  {
    "id": "policy.check",
    "version": "1.0.0",
    "summary": "Evaluate the active policy against a hypothetical command without running it.",
    "category": "meta",
    "riskDefault": "LOW",
    "params": {
      "command": { "type": "string", "required": true, "description": "The IDEL command line to evaluate." }
    },
    "adapters": {},
    "examples": ["policy.check command=\"remove.folder name=dist recursive=true\""],
    "tests": [{ "input": "policy.check command=\"remove.folder name=dist\"", "expectRisk": "LOW" }]
  },
  {
    "id": "logs.list",
    "version": "1.0.0",
    "summary": "List recent OpenLog audit records for this session or user.",
    "category": "meta",
    "riskDefault": "LOW",
    "params": {
      "limit": { "type": "number", "default": 20, "description": "Maximum number of records to list." }
    },
    "adapters": {},
    "examples": ["logs.list", "logs.list limit=50"],
    "tests": [{ "input": "logs.list limit=10", "expectRisk": "LOW" }]
  },
  {
